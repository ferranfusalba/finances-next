// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
}

// The account type decides which transaction types the account may hold — see
// allowedTransactionTypes in lib/utils/transaction.ts, which is the single
// source of that rule. It is immutable once set.
//
// CHECKING / SAVINGS / CASH / PREPAID are transaction-driven and behave
// identically to one another: income, expense, transfer.
//
// An investment provider is TWO accounts, not one, because that is what it
// actually is: Indexa holds your money as cash before it is invested, deducts
// its fees from that cash, and retains taxes there. Cramming both into one
// account forces you to encode "where did this money come from" into the
// transaction type, which is a question a second account answers for free.
//
//   INVESTMENT      — the invested position. Return, Rounding, Transfer.
//   INVESTMENT_CASH — the cash leg. Transfer, Contribution, Withdrawal, Fee,
//                     Withholding. Linked to its INVESTMENT parent via
//                     parentAccountId and rendered as a second table on the
//                     same page.
//
// INVESTMENT_LEGACY is the old single-account model, kept working untouched
// while the new one is trialled. It is the *renamed* original value, so
// existing accounts follow it automatically and keep their INCOME/EXPENSE rows
// editable. It dies at cutover.
enum AccountType {
  CHECKING
  SAVINGS
  CASH
  PREPAID
  INVESTMENT
  INVESTMENT_CASH
  INVESTMENT_LEGACY
}

model User {
  id                        String                    @id @default(cuid())
  name                      String?
  email                     String?                   @unique
  emailVerified             DateTime?
  image                     String?
  password                  String?
  role                      UserRole                  @default(USER)
  userAccounts              UserAccount[]
  userTransactionPayee      UserTransactionPayee[]
  userTransactionCategories UserTransactionCategory[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  accounts                  Account[]
  salaries                  Salary[]
  userCountry               String                    @default("") @map("defaultCountry")
  userCurrency              String                    @default("") @map("defaultCurrency")
  userTimezone              String                    @default("") @map("defaultTimezone")
  userLocale                String                    @default("") @map("defaultLocale")
  theme                     String                    @default("")
  weekStartsOn              Int                       @default(0)
  preferencesSet            Boolean                   @default(false)
  defaultTaxRate            Decimal                   @default(21)
  twoFactorEnabled          Boolean                   @default(false)
  totpSecret                String?
  twoFactorBackupCodes      TwoFactorBackupCode[]
}

model UserAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserTransactionPayee {
  id     String  @id @default(cuid())
  userId String?
  name   String

  User User? @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model UserTransactionCategory {
  id             String   @id @default(cuid())
  userId         String?
  name           String
  type           String
  color          String
  defaultTaxRate Decimal?
  recurring      String?

  User          User?                        @relation(fields: [userId], references: [id])
  subcategories UserTransactionSubcategory[]

  @@unique([userId, name, type])
}

model UserTransactionSubcategory {
  id             String                  @id @default(cuid())
  userId         String?
  name           String
  defaultTaxRate Decimal?
  recurring      String?
  category       UserTransactionCategory @relation(fields: [categoryId], references: [id])
  categoryId     String

  @@unique([categoryId, name])
}

model TwoFactorBackupCode {
  id     String @id @default(cuid())
  userId String
  code   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model AccountTransaction {
  id                          String         @id @default(uuid())
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  payee                       String         @default("")
  concept                     String
  type                        String
  typeTransferOrigin          String?        @default("")
  typeTransferDestination     String?        @default("")
  transferId                  String?
  currency                    String
  amount                      Decimal
  foreignCurrency             String?        @default("")
  foreignCurrencyAmount       Decimal?       @default(0.00)
  foreignCurrencyExchangeRate Decimal?       @default(0.00)
  category                    String         @default("")
  subcategory                 String?        @default("")
  tags                        String[]
  dateTime                    DateTime       @default(now())
  timezoneId                  String?        @default("") @map("timezone")
  timezoneOffset              String?        @default("")
  location                    Json?
  notes                       String
  recurring                   String?
  taxLines                    TaxLine[]
  Account                     Account?       @relation(fields: [accountId], references: [id])
  accountId                   String
  salaryPayment               SalaryPayment?

  @@index([accountId, dateTime])
}

model TaxLine {
  id                   String             @id @default(uuid())
  rate                 Decimal
  amount               Decimal
  inclusive            Boolean
  taxAmount            Decimal
  accountTransaction   AccountTransaction @relation(fields: [accountTransactionId], references: [id], onDelete: Cascade)
  accountTransactionId String
}

model Salary {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  month     DateTime
  employer  String
  grossPay  Decimal  @db.Decimal(10, 2)
  currency  String
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    SalaryLine[]
  payments SalaryPayment[]

  @@unique([userId, month, employer])
  @@index([userId, month])
}

model SalaryLine {
  id       String  @id @default(cuid())
  salaryId String
  salary   Salary  @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  concept  String
  group    String
  amount   Decimal @db.Decimal(10, 2)
  order    Int     @default(0)

  @@index([salaryId])
}

model SalaryPayment {
  id            String             @id @default(cuid())
  salaryId      String
  salary        Salary             @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  transactionId String             @unique
  transaction   AccountTransaction @relation(fields: [transactionId], references: [id])
  concept       String             @default("")

  @@index([salaryId])
}

model Account {
  id              String               @id @default(uuid())
  order           Int                  @default(autoincrement())
  name            String
  code            String
  bankName        String               @default("")
  active          Boolean
  type            AccountType
  description     String?
  defaultCurrency String               @default("")
  currentBalance  Decimal              @default(0)
  number          String?
  country         String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  User            User?                @relation(fields: [userId], references: [id])
  userId          String?
  transactions    AccountTransaction[]

  // An INVESTMENT_CASH account hangs off its INVESTMENT parent. Both are real
  // accounts — so transfers between them use the ordinary mirror machinery, and
  // each has its own opening and its own reconcilable balance — but they render
  // as one page with two tables, and roll up to one row in the overview.
  parentAccountId String?
  parentAccount   Account?             @relation("AccountChildren", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts   Account[]            @relation("AccountChildren")

  @@unique([userId, code])
  @@index([parentAccountId])
}

